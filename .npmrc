# better-sqlite3 kendi binding.gyp'sini içerdiği için npm onu varsayılan olarak
# node-gyp ile kaynaktan derlemeye çalışır; bu da Windows'ta Visual Studio + C++
# derleyicisi ister. Paket zaten hazır binary'leri prebuilds/ altında gönderiyor
# (win32-x64 dahil), dolayısıyla derleme adımı gereksiz. Diğer bağımlılıkların
# hiçbirinin install script'i yok, bu yüzden scriptleri toptan kapatmak güvenli.
ignore-scripts=true
